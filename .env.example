# Skopiuj do .env na serwerze i uzupełnij.

# Port, na który Cytrus przekierowuje ruch (jeden z portów przydzielonych Mikrusowi).
PORT=3000

# Pełny adres publiczny – potrzebny SvelteKit do ochrony formularzy (CSRF).
ORIGIN=https://quiz.proem.pl

# Gdzie trzymać bazę SQLite i pliki (MP3, obrazki). Poza katalogiem z kodem.
DATA_DIR=/home/user/proem-quiz-data

# Klucz do szyfrowania sekretów TOTP w bazie: 32 bajty w base64.
# Wygeneruj: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=
