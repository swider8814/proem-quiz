# Skopiuj do ~/proem-quiz/.env na Mikrusie i uzupełnij.

# Port Mikrusa, na który Cytrus przekierowuje ruch (jeden z przydzielonych portów).
PORT=3000

# Pełny adres publiczny – potrzebny do ochrony formularzy (CSRF).
ORIGIN=https://quiz.proem.pl

# Klucz do szyfrowania sekretów TOTP w bazie (32 bajty, base64).
# Wygeneruj: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=

# Adresy proxy (Cytrus), którym wolno podawać X-Forwarded-For. Patrz README, krok 8.
TRUSTED_PROXIES=

# E-maile (zaproszenia, reset hasła) przez SendGrid. Bez tych zmiennych linki trzeba przekazywać ręcznie.
# MAIL_FROM musi być zweryfikowany w SendGrid (Settings → Sender Authentication).
SENDGRID_API_KEY=
MAIL_FROM=quiz@proem.pl
MAIL_FROM_NAME=Proem Quiz
