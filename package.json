{
	"name": "proem-quiz",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:generate": "drizzle-kit generate",
		"start": "node server/index.js",
		"test": "node tests/profanity.test.mjs && node tests/net.test.mjs && node tests/engine.test.mjs && node tests/realtime-security.test.mjs && tsx tests/media-sweep.test.ts && node tests/deploy-files.test.mjs",
		"test:e2e": "node tests/e2e-auth.test.mjs && node tests/http-security.test.mjs && node tests/panel.test.mjs && node tests/i18n.test.mjs && node tests/backup.test.mjs",
		"test:load": "node tests/load/run.mjs 300 10",
		"test:ui": "node tests/game-ui.e2e.mjs && node tests/image-answers.e2e.mjs && node tests/types-ui.e2e.mjs && node tests/editor-ui.e2e.mjs && node tests/auth-ui.e2e.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/qrcode": "^1.5.6",
		"drizzle-kit": "^0.31.11",
		"playwright-core": "^1.65.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/montserrat": "^5.3.0",
		"@fontsource-variable/plus-jakarta-sans": "^5.3.0",
		"@node-rs/argon2": "^2.2.2",
		"better-sqlite3": "^13.2.0",
		"drizzle-orm": "^0.45.4",
		"otplib": "^13.6.0",
		"qrcode": "^1.5.4",
		"socket.io": "^4.8.4",
		"socket.io-client": "^4.8.4",
		"wavesurfer.js": "^8.1.0",
		"zod": "^4.6.7"
	}
}
