# Skopiuj jako .env.local i uzupełnij (plik .env.local nie trafia do repozytorium).
# Adres komputera w sieci Wi-Fi (Windows: ipconfig → „Adres IPv4”; Mac: Ustawienia → Wi-Fi → Szczegóły).
ORIGIN=http://192.168.1.20:3000
# Losowe 32 bajty w base64 – TYLKO do prób. Wygeneruj:
#   Windows (PowerShell): [Convert]::ToBase64String((1..32 | % { Get-Random -Maximum 256 }) -as [byte[]])
#   Mac / Linux:          openssl rand -base64 32
TOTP_ENCRYPTION_KEY=
